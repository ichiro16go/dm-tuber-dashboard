# --- Supabase（読み取り: アプリ / 書き込み: バッチのみ） ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxx
# バッチ処理 (scripts/fetch-youtube-data.ts) 専用。ブラウザに露出させないこと。
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxx
# GitHub Actions 側で SUPABASE_URL として渡す場合はこちらも使用可
SUPABASE_URL=https://xxxxxxxx.supabase.co

# --- YouTube Data API（バッチ処理専用） ---
YOUTUBE_API_KEY=xxxxxxxx

# ショート動画判定の閾値（秒）。省略時 180 秒。
SHORTS_MAX_DURATION_SECONDS=180
